pipeline {
    agent {
        docker { image 'node:16-alpine' }
    }
    stages {
        stage('Check Birthday') {
            steps {
                script {
                    def a = 10
                    def b = 6
                    def c = a + b
                    if (c == 16) {
                        echo "My birthday"
                    } else {
                        echo "Sorry"
                    }
                }
            }
        }
    }
}
